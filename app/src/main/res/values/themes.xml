<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash_bg">#121212</color>
    <color name="accent">#1ED760</color>

    <style name="Theme.Attic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Attic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Attic</item>
    </style>

    <style name="WidgetTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/widget_tile_bg</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:contentDescription">@string/widget_album</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
</resources>
