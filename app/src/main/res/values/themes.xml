<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="plum">#16101F</color>
    <color name="marigold">#FFB627</color>

    <style name="Theme.Attic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/plum</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Attic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/plum</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Attic</item>
    </style>
</resources>
