<?xml version="1.0" encoding="utf-8"?>
<!--
    Onest, Comfort's face, for the widget's text views: the bundled variable font pinned to the two
    weights the widget uses, so textStyle="bold" picks 700 instead of a synthetic bold.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/onest"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/onest"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
